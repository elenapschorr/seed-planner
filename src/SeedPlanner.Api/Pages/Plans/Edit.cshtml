@page "{id:int?}"
@model SeedPlanner.Api.Pages.Plans.EditModel
@{
    ViewData["Title"] = (Model.Id is null ? L["PlanEdit_TitleNew"] : L["PlanEdit_TitleEdit"]).Value;
}

<h1 class="mb-3">@ViewData["Title"]</h1>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Input.Name" class="form-label">@L["Col_Name"]</label>
        <input asp-for="Input.Name" class="form-control" maxlength="100" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.ValidFrom" class="form-label">@L["Plan_ValidFrom"]</label>
        <input asp-for="Input.ValidFrom" type="date" class="form-control" />
        <span asp-validation-for="Input.ValidFrom" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.ValidTo" class="form-label">@L["Plan_ValidTo"]</label>
        <input asp-for="Input.ValidTo" type="date" class="form-control" />
        <span asp-validation-for="Input.ValidTo" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Persons" class="form-label">@L["Plan_Persons"]</label>
        <input asp-for="Input.Persons" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Input.Persons" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.Level" class="form-label">@L["Plan_Level"]</label>
        <select asp-for="Input.Level" asp-items="Model.LevelOptions" class="form-select"></select>
        <div class="form-text">@L["Plan_LevelHint"]</div>
    </div>
    <div class="col-md-3" id="percent-field">
        <label asp-for="Input.CustomPercent" class="form-label">@L["Plan_CustomPercent"]</label>
        <input asp-for="Input.CustomPercent" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Input.CustomPercent" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Input.IncludeOutOfStock" class="form-check-input" />
            <label asp-for="Input.IncludeOutOfStock" class="form-check-label">@L["Plan_IncludeOutOfStock"]</label>
        </div>
        <div class="form-text">@L["Plan_IncludeOutOfStockHint"]</div>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-success">@(Model.Id is null ? L["Plan_Calculate"] : L["Plan_SaveRecalculate"])</button>
        <a class="btn btn-outline-secondary" asp-page="@(Model.Id is null ? "Index" : "Details")" asp-route-id="@Model.Id">@L["Action_Cancel"]</a>
    </div>
</form>

<script>
    // The position between minimum and maximum is only needed for "own value"
    (function () {
        var level = document.getElementById("Input_Level");
        var field = document.getElementById("percent-field");
        function update() { field.hidden = level.value !== "Custom"; }
        level.addEventListener("change", update);
        update();
    })();

    // Changing the start moves the end by the same number of days, so the length of the plan stays.
    // If the end was the last day of a month, it stays the last day of a month (moved by the same number of months).
    (function () {
        var from = document.getElementById("Input_ValidFrom"), to = document.getElementById("Input_ValidTo");
        var DAY = 24 * 60 * 60 * 1000;
        function day(value) { return value ? Date.parse(value + "T00:00:00Z") : NaN; }
        var previous = day(from.value);
        function movedEnd(oldStart, newStart, oldEnd) {
            var s0 = new Date(oldStart), s1 = new Date(newStart), e0 = new Date(oldEnd);
            var lastOfMonth = new Date(Date.UTC(e0.getUTCFullYear(), e0.getUTCMonth() + 1, 0)).getUTCDate() === e0.getUTCDate();
            if (!lastOfMonth) return new Date(oldEnd + (newStart - oldStart));
            var months = (s1.getUTCFullYear() - s0.getUTCFullYear()) * 12 + s1.getUTCMonth() - s0.getUTCMonth();
            return new Date(Date.UTC(e0.getUTCFullYear(), e0.getUTCMonth() + months + 1, 0));
        }
        from.addEventListener("change", function () {
            var now = day(from.value), end = day(to.value);
            if (!isNaN(now) && !isNaN(previous) && !isNaN(end))
                to.value = movedEnd(previous, now, end).toISOString().slice(0, 10);
            else if (!isNaN(now) && isNaN(end))
                to.value = new Date(now + 364 * DAY).toISOString().slice(0, 10);
            previous = now;
        });
    })();
</script>
