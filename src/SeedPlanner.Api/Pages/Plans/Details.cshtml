@page "{id:int}"
@model SeedPlanner.Api.Pages.Plans.DetailsModel
@{
    ViewData["Title"] = Model.Plan.Name;
    ViewData["Wide"] = true;
    var itemIndex = 0;
    var lineIndex = 0;
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="mb-0">@Model.Plan.Name</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="Distribution" asp-route-id="@Model.Plan.Id">@L["Plan_Distribute"]</a>
        <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@Model.Plan.Id">@L["Plan_EditSettings"]</a>
    </div>
</div>
<p class="text-muted">
    @L["Plan_SummaryLine", Model.Plan.Year, Model.Plan.Persons, Model.LevelText]
    @if (Model.Plan.IncludeOutOfStock)
    {
        <span> · @L["Plan_IncludeOutOfStockShort"]</span>
    }
</p>

@if (Model.Saved)
{
    <div class="alert alert-success" role="status">@L["Plan_Saved"]</div>
}

@if (Model.Crops.Count == 0)
{
    <p class="text-muted">@L["Plan_NoCrops"] <a asp-page="/Demand/Index">@L["Nav_Demand"]</a></p>
}
else
{
    <form method="post" asp-page-handler="Save" asp-route-id="@Model.Plan.Id">
        <div class="mb-2">
            <span class="text-muted small" id="crop-count" data-template="@L["Plan_CropsIncluded"].Value">@L["Plan_CropsIncluded", Model.IncludedCrops, Model.Crops.Count]</span>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-3" id="fold-all">@L["Action_ToggleAll"]</button>
            <div class="form-text">@L["Plan_SowingTimingHelp"]</div>
        </div>
        <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@L["Plan_CropVariety"]</th>
                    <th class="text-end">@L["Plan_Demand"]</th>
                    <th class="text-end">@L["Plan_Calculated"]</th>
                    <th>@L["Plan_OwnNumber"]</th>
                    <th>@L["Plan_SowingTiming"]</th>
                    <th>
                        <input type="checkbox" class="form-check-input me-1" id="crop-all" aria-label="@L["Plan_IncludeAll"].Value" />
                        @L["Plan_Include"]
                    </th>
                </tr>
            </thead>
            @foreach (var item in Model.Crops)
            {
                var state = SeedPlanner.Api.Pages.Plans.DetailsModel.StateOf(item);
                <tbody class="crop-@state" data-crop>
                    <tr class="table-light">
                        <td>
                            <input type="hidden" name="Items[@itemIndex].Id" value="@item.Id" />
                            <button type="button" class="btn btn-link p-0 me-1 text-decoration-none crop-toggle" aria-expanded="true" data-id="@item.Id">▾</button>
                            <a asp-page="/PlantTypes/Details" asp-route-id="@item.PlantTypeId" class="text-decoration-none"><strong>@Model.CropName(item)</strong></a>
                            <span class="text-muted small ms-1 d-none crop-lines-count">(@Model.LinesOf(item).Count())</span>
                            <span class="badge crop-badge ms-2 @(state == "full" ? "text-bg-success" : state == "partial" ? "text-bg-warning" : "d-none")"
                                  data-full="@L["Plan_CropFull"].Value" data-partial="@L["Plan_CropPartial"].Value">@(state == "full" ? L["Plan_CropFull"].Value : L["Plan_CropPartial"].Value)</span>
                        </td>
                        <td class="text-end">@Model.AmountText(item)</td>
                        <td class="text-end">@(item.CalculatedPlants is null ? "–" : item.CalculatedPlants.ToString())</td>
                        <td>
                            @if (SeedPlanner.Api.Pages.Plans.DetailsModel.UsesAmount(item))
                            {
                                <div class="input-group input-group-sm" style="width: 13rem;">
                                    @{
                                        var shown = (item.AmountOverride ?? item.DemandAmount)?.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture) ?? "";
                                    }
                                    <input type="hidden" name="Items[@itemIndex].ShownAmount" value="@shown" />
                                    <input type="text" inputmode="decimal" name="Items[@itemIndex].AmountOverride" value="@shown" data-shown="@shown"
                                           class="form-control own-number @(item.AmountOverride is null ? "text-muted" : "")"
                                           aria-label="@L["Plan_OwnNumber"].Value" />
                                    <span class="input-group-text">@Model.UnitText(item)</span>
                                </div>
                                @if (item.AmountOverride is not null && item.PlantsOverride is not null)
                                {
                                    <div class="form-text mt-0">= @item.PlantsOverride @L["Plan_Plants"]</div>
                                }
                            }
                            else
                            {
                                <div class="input-group input-group-sm" style="width: 13rem;">
                                    @{
                                        var shownPlants = item.PlantsOverride ?? item.CalculatedPlants;
                                    }
                                    <input type="hidden" name="Items[@itemIndex].ShownPlants" value="@shownPlants" />
                                    <input type="number" min="0" name="Items[@itemIndex].PlantsOverride" value="@shownPlants" data-shown="@shownPlants"
                                           class="form-control own-number @(item.PlantsOverride is null ? "text-muted" : "")" aria-label="@L["Plan_OwnNumber"].Value" />
                                    <span class="input-group-text">@L["Plan_Plants"]</span>
                                </div>
                            }
                            @if (item.Lines.Any(l => l.Include && l.PlantsOverride is not null))
                            {
                                <button type="submit" name="SpreadItemId" value="@item.Id" class="btn btn-link btn-sm p-0 mt-1 text-start">@L["Plan_SpreadEvenly"]</button>
                            }
                        </td>
                        <td>
                            <select name="Items[@itemIndex].SowingTiming" class="form-select form-select-sm" style="width: 9rem;" aria-label="@L["Plan_SowingTiming"].Value">
                                @foreach (var t in Enum.GetValues<SeedPlanner.Domain.SowingTiming>())
                                {
                                    <option value="@t" selected="@(item.SowingTiming == t)">@Model.TimingText(t)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input type="checkbox" class="form-check-input crop-include" checked="@(state == "full")" aria-label="@L["Plan_IncludeCrop"].Value" />
                        </td>
                    </tr>
                    @if (item.NeedsNumber)
                    {
                        <tr class="crop-detail"><td colspan="6" class="text-danger small">@L["Plan_NoSpacing"]</td></tr>
                    }
                    else if (!item.Lines.Any(l => l.Include))
                    {
                        <tr class="crop-detail"><td colspan="6" class="text-danger small">@L["Plan_NoVariety"]</td></tr>
                    }
                    @foreach (var line in Model.LinesOf(item))
                    {
                        <tr class="crop-detail">
                            <td class="ps-4">
                                <input type="hidden" name="Lines[@lineIndex].Id" value="@line.Id" />
                                <a asp-page="/Plants/Edit" asp-route-id="@line.PlantId" class="text-decoration-none">@Model.VarietyName(line)</a>
                                @if (line.OutOfStock)
                                {
                                    <span class="badge text-bg-warning ms-1">@L["StockStatus_OutOfStock"]</span>
                                }
                                @if (line.ToBuy)
                                {
                                    <span class="badge text-bg-secondary ms-1">@L["Plan_ToBuy"]</span>
                                }
                            </td>
                            <td></td>
                            <td class="text-end">@(line.Include ? line.CalculatedPlants : 0)</td>
                            <td>
                                @{
                                    int? shownLine = line.Include ? line.Plants : null;
                                }
                                <input type="hidden" name="Lines[@lineIndex].ShownPlants" value="@shownLine" />
                                <input type="number" min="0" name="Lines[@lineIndex].PlantsOverride" value="@shownLine" data-shown="@shownLine"
                                       class="form-control form-control-sm own-number @(line.PlantsOverride is null ? "text-muted" : "")" style="width: 6rem;" aria-label="@L["Plan_OwnNumber"].Value" />
                            </td>
                            <td></td>
                            <td>
                                <input type="checkbox" class="form-check-input line-include" name="Lines[@lineIndex].Include" value="true" checked="@line.Include" aria-label="@L["Plan_Include"].Value" />
                                <input type="hidden" name="Lines[@lineIndex].Include" value="false" />
                            </td>
                        </tr>
                        lineIndex++;
                    }
                </tbody>
                itemIndex++;
            }
            <tfoot>
                <tr>
                    <th colspan="2">@L["Plan_Total"]</th>
                    <th class="text-end">@Model.CalculatedTotal</th>
                    <th>@Model.TotalPlants @L["Plan_Plants"]</th>
                    <th colspan="2"></th>
                </tr>
            </tfoot>
        </table>
        </div>

        <p class="text-muted small">@L["Plan_SaveHint"]</p>
        <button type="submit" class="btn btn-success">@L["Action_Save"]</button>
    </form>

    @if (Model.Plan.ShoppingList.Any())
    {
        <h2 class="h5 mt-5">@L["Plan_ShoppingList"]</h2>
        <p class="text-muted">@L["Plan_ShoppingListHint"]</p>
        <ul>
            @foreach (var item in Model.Crops)
            {
                foreach (var line in Model.LinesOf(item).Where(l => l.ToBuy))
                {
                    <li>@Model.CropName(item) – @Model.VarietyName(line) <span class="text-muted">×@line.Plants</span></li>
                }
            }
        </ul>
    }
}

@{
    var confirmText = L["PlanConfirm_Delete"].Value;
}
<form method="post" asp-page-handler="Delete" asp-route-id="@Model.Plan.Id" class="mt-4"
      data-confirm="@confirmText" onsubmit="return confirm(this.dataset.confirm);">
    <button type="submit" class="btn btn-outline-danger">@L["Action_Delete"]</button>
</form>

@section Scripts {
    <script>
        // The fields are filled with the calculated value (grey); a changed value is an own number (normal text)
        document.querySelectorAll("input.own-number").forEach(function (input) {
            input.addEventListener("input", function () {
                input.classList.toggle("text-muted", input.value.trim() === (input.dataset.shown || ""));
            });
        });
    </script>
    <style>
        tbody.crop-none { opacity: .55; }
        tbody.crop-full > tr.table-light > td:first-child { box-shadow: inset 4px 0 0 var(--bs-success); }
        tbody.crop-partial > tr.table-light > td:first-child { box-shadow: inset 4px 0 0 var(--bs-warning); }
    </style>
    <script>
        // The choice is made per variety. A crop box sets all its varieties; the crop is marked as
        // fully (all varieties) or partly (some varieties) included. The header box does the same for all crops.
        // Nothing is saved before the Save button.
        (function () {
            var bodies = Array.prototype.slice.call(document.querySelectorAll('tbody[data-crop]'));
            var master = document.getElementById('crop-all');
            var counter = document.getElementById('crop-count');

            // Fold the varieties of a crop; the state is kept for this session
            var foldKey = 'plan-crops-v1:@Model.Plan.Id';
            var folded = {};
            try { folded = JSON.parse(sessionStorage.getItem(foldKey) || '{}'); } catch (e) { }
            function setFold(body, closed) {
                var button = body.querySelector('.crop-toggle');
                body.querySelectorAll('.crop-detail').forEach(function (row) { row.hidden = closed; });
                button.textContent = closed ? '▸' : '▾';
                button.setAttribute('aria-expanded', closed ? 'false' : 'true');
                body.querySelector('.crop-lines-count').classList.toggle('d-none', !closed);
            }
            // One button for all crops: if any is open, close all; otherwise open all
            document.getElementById('fold-all').addEventListener('click', function () {
                var closeAll = bodies.some(function (body) { return body.querySelector('.crop-toggle').getAttribute('aria-expanded') === 'true'; });
                folded = {};
                bodies.forEach(function (body) {
                    setFold(body, closeAll);
                    if (closeAll) folded[body.querySelector('.crop-toggle').dataset.id] = 1;
                });
                try { sessionStorage.setItem(foldKey, JSON.stringify(folded)); } catch (e) { }
            });
            bodies.forEach(function (body) {
                var button = body.querySelector('.crop-toggle');
                setFold(body, !!folded[button.dataset.id]);
                button.addEventListener('click', function () {
                    var closed = button.getAttribute('aria-expanded') === 'true';
                    setFold(body, closed);
                    if (closed) folded[button.dataset.id] = 1; else delete folded[button.dataset.id];
                    try { sessionStorage.setItem(foldKey, JSON.stringify(folded)); } catch (e) { }
                });
            });

            function linesOf(body) {
                return Array.prototype.slice.call(body.querySelectorAll('.line-include'));
            }

            function refresh() {
                var cropsOn = 0, cropsFull = 0;
                bodies.forEach(function (body) {
                    var lines = linesOf(body);
                    var on = lines.filter(function (l) { return l.checked; }).length;
                    var state = on === 0 ? 'none' : (on === lines.length ? 'full' : 'partial');
                    var box = body.querySelector('.crop-include');
                    box.checked = state === 'full';
                    box.indeterminate = state === 'partial';
                    body.classList.remove('crop-full', 'crop-partial', 'crop-none');
                    body.classList.add('crop-' + state);
                    var badge = body.querySelector('.crop-badge');
                    badge.classList.toggle('d-none', state === 'none');
                    badge.classList.toggle('text-bg-success', state === 'full');
                    badge.classList.toggle('text-bg-warning', state === 'partial');
                    badge.textContent = state === 'full' ? badge.dataset.full : badge.dataset.partial;
                    if (state !== 'none') cropsOn++;
                    if (state === 'full') cropsFull++;
                });
                master.checked = bodies.length > 0 && cropsFull === bodies.length;
                master.indeterminate = cropsOn > 0 && cropsFull < bodies.length;
                if (counter && counter.dataset.template) {
                    counter.textContent = counter.dataset.template.replace('{0}', cropsOn).replace('{1}', bodies.length);
                }
            }

            master.addEventListener('change', function () {
                bodies.forEach(function (body) {
                    linesOf(body).forEach(function (l) { l.checked = master.checked; });
                });
                refresh();
            });
            bodies.forEach(function (body) {
                body.querySelector('.crop-include').addEventListener('change', function (e) {
                    linesOf(body).forEach(function (l) { l.checked = e.target.checked; });
                    refresh();
                });
                linesOf(body).forEach(function (l) { l.addEventListener('change', refresh); });
            });
            refresh();
        })();
    </script>
}
