@page
@model SeedPlanner.Api.Pages.PlantTypes.IndexModel
@using SeedPlanner.Domain
@{
    ViewData["Title"] = L["PlantTypes_Title"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["PlantTypes_Title"]</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-success" asp-page="/PlantTypes/Edit">@L["PlantTypeAction_New"]</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sort" value="@Model.Sort" />
    <input type="hidden" name="dir" value="@Model.Dir" />
    <div class="col-md">
        <input type="search" name="q" value="@Model.Q" class="form-control" placeholder="@L["Search"].Value" />
    </div>
    <div class="col-md-auto">
        <select name="category" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllCategories"]</option>
            @foreach (var c in Enum.GetValues<PlantCategory>())
            {
                <option value="@c" selected="@(Model.Category == c)">@L["Category_" + c]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="lifecycle" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllLifecycles"]</option>
            @foreach (var lc in Enum.GetValues<Lifecycle>())
            {
                <option value="@lc" selected="@(Model.LifecycleFilter == lc)">@L["Lifecycle_" + lc]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="nutrient" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllNutrientDemands"]</option>
            @foreach (var n in Enum.GetValues<NutrientDemand>())
            {
                <option value="@n" selected="@(Model.NutrientFilter == n)">@L["NutrientDemand_" + n]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="exposure" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllExposures"]</option>
            @foreach (var e in Enum.GetValues<Exposure>())
            {
                <option value="@e" selected="@(Model.ExposureFilter == e)">@L["Exposure_" + e]</option>
            }
        </select>
    </div>
</form>

@{
    // Addresses of the column titles (keep the filters, reverse the direction on a second click)
    var sort_name = Model.SortRoute("name");
    var sort_category = Model.SortRoute("category");
    var sort_lifecycle = Model.SortRoute("lifecycle");
    var sort_nutrient = Model.SortRoute("nutrient");
    var sort_exposure = Model.SortRoute("exposure");
    var sort_plants = Model.SortRoute("plants");
}

<table class="table table-hover">
    <thead>
        <tr>
            <th><a asp-page="/PlantTypes/Index" asp-all-route-data="sort_name" class="text-decoration-none text-reset">@L["Col_Name"]@Model.Arrow("name")</a></th>
            <th><a asp-page="/PlantTypes/Index" asp-all-route-data="sort_category" class="text-decoration-none text-reset">@L["Col_Category"]@Model.Arrow("category")</a></th>
            <th><a asp-page="/PlantTypes/Index" asp-all-route-data="sort_lifecycle" class="text-decoration-none text-reset">@L["Col_Lifecycle"]@Model.Arrow("lifecycle")</a></th>
            <th><a asp-page="/PlantTypes/Index" asp-all-route-data="sort_nutrient" class="text-decoration-none text-reset">@L["Col_NutrientDemand"]@Model.Arrow("nutrient")</a></th>
            <th><a asp-page="/PlantTypes/Index" asp-all-route-data="sort_exposure" class="text-decoration-none text-reset">@L["Col_Exposure"]@Model.Arrow("exposure")</a></th>
            <th class="text-end"><a asp-page="/PlantTypes/Index" asp-all-route-data="sort_plants" class="text-decoration-none text-reset">@L["Col_Plants"]@Model.Arrow("plants")</a></th>
            @if (Model.CanEdit)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><strong><a asp-page="/PlantTypes/Details" asp-route-id="@r.Id" class="text-decoration-none">@r.Name</a></strong></td>
                <td>@(r.Category is null ? "–" : L["Category_" + r.Category].Value)</td>
                <td>@(r.Lifecycle is null ? "–" : L["Lifecycle_" + r.Lifecycle].Value)</td>
                <td>@(r.NutrientDemand is null ? "–" : L["NutrientDemand_" + r.NutrientDemand].Value)</td>
                <td>@(r.Exposure is null ? "–" : L["Exposure_" + r.Exposure].Value)</td>
                <td class="text-end">@r.PlantCount</td>
                @if (Model.CanEdit)
                {
                    <td class="text-end"><a asp-page="/PlantTypes/Edit" asp-route-id="@r.Id" asp-route-returnUrl="@Model.CurrentUrl">@L["Action_Edit"]</a></td>
                }
            </tr>
        }
    </tbody>
</table>
