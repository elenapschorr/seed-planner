@page
@model SeedPlanner.Api.Pages.PlantTypes.IndexModel
@using SeedPlanner.Domain
@{
    ViewData["Title"] = L["PlantTypes_Title"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["PlantTypes_Title"]</h1>
    @if (Model.CanEdit)
    {
        <a class="btn btn-success" asp-page="/PlantTypes/Edit">@L["PlantTypeAction_New"]</a>
    }
</div>

<partial name="_FilterBar" model="Model.Filter" />


<table class="table table-hover">
    <thead>
        <tr>
            <th><a href="@Model.Filter.SortUrl("name")" class="text-decoration-none text-reset">@L["Col_Name"]@Model.Filter.Arrow("name")</a></th>
            <th><a href="@Model.Filter.SortUrl("category")" class="text-decoration-none text-reset">@L["Col_Category"]@Model.Filter.Arrow("category")</a></th>
            <th><a href="@Model.Filter.SortUrl("lifecycle")" class="text-decoration-none text-reset">@L["Col_Lifecycle"]@Model.Filter.Arrow("lifecycle")</a></th>
            <th><a href="@Model.Filter.SortUrl("nutrient")" class="text-decoration-none text-reset">@L["Col_NutrientDemand"]@Model.Filter.Arrow("nutrient")</a></th>
            <th><a href="@Model.Filter.SortUrl("exposure")" class="text-decoration-none text-reset">@L["Col_Exposure"]@Model.Filter.Arrow("exposure")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("plants")" class="text-decoration-none text-reset">@L["Col_Plants"]@Model.Filter.Arrow("plants")</a></th>
            @if (Model.CanEdit)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><strong><a asp-page="/PlantTypes/Details" asp-route-id="@r.Id" class="text-decoration-none">@r.Name</a></strong></td>
                <td>@(r.Category is null ? "–" : L["Category_" + r.Category].Value)</td>
                <td>@(r.Lifecycle is null ? "–" : L["Lifecycle_" + r.Lifecycle].Value)</td>
                <td>@(r.NutrientDemand is null ? "–" : L["NutrientDemand_" + r.NutrientDemand].Value)</td>
                <td>@(r.Exposure is null ? "–" : L["Exposure_" + r.Exposure].Value)</td>
                <td class="text-end">@r.PlantCount</td>
                @if (Model.CanEdit)
                {
                    <td class="text-end"><a asp-page="/PlantTypes/Edit" asp-route-id="@r.Id" asp-route-returnUrl="@Model.CurrentUrl">@L["Action_Edit"]</a></td>
                }
            </tr>
        }
    </tbody>
</table>
