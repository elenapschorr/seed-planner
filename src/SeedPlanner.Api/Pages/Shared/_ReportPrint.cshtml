@model SeedPlanner.Api.Pages.Plans.ReportDocument
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <style>
        body { font-family: Georgia, "Times New Roman", serif; color: #222; margin: 2rem; }
        h1 { margin: 0 0 .25rem; font-size: 1.6rem; }
        h2 { font-size: 1.15rem; margin: 1.8rem 0 .4rem; }
        .sub { color: #666; margin: 0 0 1rem; }
        table { border-collapse: collapse; width: 100%; font-size: .9rem; }
        th, td { border-bottom: 1px solid #ccc; padding: .25rem .5rem; text-align: left; vertical-align: top; }
        th { border-bottom: 2px solid #222; }
        .empty { color: #888; font-style: italic; }
        button { font: inherit; padding: .3rem .9rem; margin-bottom: 1rem; }
        @@media print { button { display: none; } body { margin: 0; } h2 { break-after: avoid; } tr { break-inside: avoid; } }
    </style>
</head>
<body>
    <button type="button" onclick="window.print()">@L["Report_Print"]</button>
    <h1>@Model.Title</h1>
    <p class="sub">@Model.Subtitle</p>
    @foreach (var table in Model.Tables)
    {
        <h2>@table.Title</h2>
        if (table.Rows.Count == 0)
        {
            <p class="empty">–</p>
            continue;
        }
        <table>
            <thead>
                <tr>@foreach (var heading in table.Columns) { <th>@heading</th> }</tr>
            </thead>
            <tbody>
                @foreach (var row in table.Rows)
                {
                    <tr>@foreach (var cell in row) { <td>@cell</td> }</tr>
                }
            </tbody>
        </table>
    }
</body>
</html>
