@using System.Globalization
@inject IStringLocalizer<SharedResource> L
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seed Planner</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SeedPlanner.Api.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/PlantTypes/Index">Seed Planner</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/PlantTypes/Index">@L["Nav_PlantTypes"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Plants/Index">@L["Nav_Plants"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Pots/Index">@L["Nav_Pots"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Saucers/Index">@L["Nav_Saucers"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/RaisedBeds/Index">@L["Nav_RaisedBeds"]</a>
                        </li>
                    </ul>
                    <div class="btn-group btn-group-sm me-2" role="group">
                        <a class="btn btn-outline-secondary" href="/culture?c=de&returnUrl=@Context.Request.Path">DE</a>
                        <a class="btn btn-outline-secondary" href="/culture?c=en&returnUrl=@Context.Request.Path">EN</a>
                        <a class="btn btn-outline-secondary" href="/culture?c=ru&returnUrl=@Context.Request.Path">RU</a>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Nav_Logout"] (@User.Identity.Name)</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Account/Login">@L["Nav_Login"]</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Seed Planner - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
