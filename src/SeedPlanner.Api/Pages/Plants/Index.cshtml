@page
@model SeedPlanner.Api.Pages.Plants.IndexModel
@using SeedPlanner.Domain
@{
    ViewData["Title"] = L["Plants_Title"].Value;
    ViewData["Wide"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["Plants_Title"]</h1>
    <a class="btn btn-success" asp-page="Edit" asp-route-returnUrl="@Model.ReturnUrl">@L["Action_New"]</a>
</div>

<partial name="_FilterBar" model="Model.Filter" />

@if (Model.SeedRows.Count > 0)
{
    <h2 class="h4 mt-4">@L["Section_Seeds"] <span class="text-muted fs-6">(@Model.SeedRows.Count)</span></h2>
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
            <th><a href="@Model.SortUrl("type")" class="text-decoration-none text-reset">@L["Col_PlantType"]@Model.Arrow("type")</a></th>
            <th><a href="@Model.SortUrl("name")" class="text-decoration-none text-reset">@L["Col_Name"]@Model.Arrow("name")</a></th>
            <th><a href="@Model.SortUrl("lifecycle")" class="text-decoration-none text-reset">@L["Col_Lifecycle"]@Model.Arrow("lifecycle")</a></th>
            <th><a href="@Model.SortUrl("seedtype")" class="text-decoration-none text-reset">@L["Col_SeedType"]@Model.Arrow("seedtype")</a></th>
            <th><a href="@Model.SortUrl("stock")" class="text-decoration-none text-reset">@L["Col_Stock"]@Model.Arrow("stock")</a></th>
            <th><a href="@Model.SortUrl("sowing")" class="text-decoration-none text-reset">@L["Col_Sowing"]@Model.Arrow("sowing")</a></th>
            <th><a href="@Model.SortUrl("place")" class="text-decoration-none text-reset">@L["Col_GrowingPlace"]@Model.Arrow("place")</a></th>
            <th><a href="@Model.SortUrl("nutrient")" class="text-decoration-none text-reset">@L["Col_NutrientDemand"]@Model.Arrow("nutrient")</a></th>
            <th><a href="@Model.SortUrl("exposure")" class="text-decoration-none text-reset">@L["Col_Exposure"]@Model.Arrow("exposure")</a></th>
            <th><a href="@Model.SortUrl("tobuy")" class="text-decoration-none text-reset">@L["Badge_ToBuy"]@Model.Arrow("tobuy")</a></th>
            <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.SeedRows)
            {
                <tr>
                        <td><a asp-page="/PlantTypes/Details" asp-route-id="@r.TypeId" class="text-decoration-none">@r.TypeName</a></td>
                        <td>
                            @if (r.IsUnnamed)
                            {
                                <span class="text-muted fst-italic">@L["Plant_Unnamed"]</span>
                            }
                            else
                            {
                                <strong>@r.Name</strong>
                            }
                        </td>
                        <td>@(r.Lifecycle is null ? "–" : L["Lifecycle_" + r.Lifecycle].Value)</td>
                    <td>@(r.SeedType is null ? "–" : L["SeedType_" + r.SeedType].Value)</td>
                        <td>@L["StockStatus_" + r.StockStatus]</td>
                        <td>@(r.SowingMethod is null ? "–" : L["SowingMethod_" + r.SowingMethod].Value)</td>
                        <td>@(r.GrowingPlace is null ? "–" : L["GrowingPlace_" + r.GrowingPlace].Value)</td>
                        <td>@(r.NutrientDemand is null ? "–" : L["NutrientDemand_" + r.NutrientDemand].Value)</td>
                        <td>
                            @if (r.Exposure is null) { <text>–</text> }
                            else if (r.ExposureInherited)
                            {
                                <a asp-page="/PlantTypes/Details" asp-route-id="@r.TypeId" target="_blank" rel="noopener" title="@L["Priority_Inherited"]" class="link-primary text-decoration-underline">@L["Exposure_" + r.Exposure]</a>
                            }
                            else { @L["Exposure_" + r.Exposure] }
                        </td>
                    <td>@if (r.ShouldBuy) { <span class="badge text-bg-warning">@L["Badge_ToBuy"]</span> }</td>
                    <td class="text-end"><a asp-page="Edit" asp-route-id="@r.Id" asp-route-returnUrl="@Model.ReturnUrl">@L["Action_Edit"]</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (Model.PlantRows.Count > 0)
{
    <h2 class="h4 mt-4">@L["Section_Plants"] <span class="text-muted fs-6">(@Model.PlantRows.Count)</span></h2>
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
            <th><a href="@Model.SortUrl("type")" class="text-decoration-none text-reset">@L["Col_PlantType"]@Model.Arrow("type")</a></th>
            <th><a href="@Model.SortUrl("name")" class="text-decoration-none text-reset">@L["Col_Name"]@Model.Arrow("name")</a></th>
            <th><a href="@Model.SortUrl("propagation")" class="text-decoration-none text-reset">@L["Col_Propagation"]@Model.Arrow("propagation")</a></th>
            <th><a href="@Model.SortUrl("lifecycle")" class="text-decoration-none text-reset">@L["Col_Lifecycle"]@Model.Arrow("lifecycle")</a></th>
            <th><a href="@Model.SortUrl("stock")" class="text-decoration-none text-reset">@L["Col_Stock"]@Model.Arrow("stock")</a></th>
            <th><a href="@Model.SortUrl("sowing")" class="text-decoration-none text-reset">@L["Col_Sowing"]@Model.Arrow("sowing")</a></th>
            <th><a href="@Model.SortUrl("place")" class="text-decoration-none text-reset">@L["Col_GrowingPlace"]@Model.Arrow("place")</a></th>
            <th><a href="@Model.SortUrl("nutrient")" class="text-decoration-none text-reset">@L["Col_NutrientDemand"]@Model.Arrow("nutrient")</a></th>
            <th><a href="@Model.SortUrl("exposure")" class="text-decoration-none text-reset">@L["Col_Exposure"]@Model.Arrow("exposure")</a></th>
            <th class="text-end"><a href="@Model.SortUrl("pots")" class="text-decoration-none text-reset">@L["Col_Pots"]@Model.Arrow("pots")</a></th>
            <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.PlantRows)
            {
                <tr>
                        <td><a asp-page="/PlantTypes/Details" asp-route-id="@r.TypeId" class="text-decoration-none">@r.TypeName</a></td>
                        <td>
                            @if (r.IsUnnamed)
                            {
                                <span class="text-muted fst-italic">@L["Plant_Unnamed"]</span>
                            }
                            else
                            {
                                <strong>@r.Name</strong>
                            }
                        </td>
                    <td>@L["Propagation_" + r.Propagation]</td>
                        <td>@(r.Lifecycle is null ? "–" : L["Lifecycle_" + r.Lifecycle].Value)</td>
                        <td>@L["StockStatus_" + r.StockStatus]</td>
                        <td>@(r.SowingMethod is null ? "–" : L["SowingMethod_" + r.SowingMethod].Value)</td>
                        <td>@(r.GrowingPlace is null ? "–" : L["GrowingPlace_" + r.GrowingPlace].Value)</td>
                        <td>@(r.NutrientDemand is null ? "–" : L["NutrientDemand_" + r.NutrientDemand].Value)</td>
                        <td>
                            @if (r.Exposure is null) { <text>–</text> }
                            else if (r.ExposureInherited)
                            {
                                <a asp-page="/PlantTypes/Details" asp-route-id="@r.TypeId" target="_blank" rel="noopener" title="@L["Priority_Inherited"]" class="link-primary text-decoration-underline">@L["Exposure_" + r.Exposure]</a>
                            }
                            else { @L["Exposure_" + r.Exposure] }
                        </td>
                    <td class="text-end">@(r.PotCount == 0 ? "–" : r.PotCount.ToString())</td>
                    <td class="text-end"><a asp-page="Edit" asp-route-id="@r.Id" asp-route-returnUrl="@Model.ReturnUrl">@L["Action_Edit"]</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <p class="text-muted mt-4">@L["Plants_NoResults"]</p>
}
