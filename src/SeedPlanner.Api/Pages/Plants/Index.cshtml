@page
@model SeedPlanner.Api.Pages.Plants.IndexModel
@using SeedPlanner.Domain
@{
    ViewData["Title"] = L["Plants_Title"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@L["Plants_Title"]</h1>
    <a class="btn btn-success" asp-page="Edit">@L["Action_New"]</a>
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sort" value="@Model.Sort" />
    <input type="hidden" name="dir" value="@Model.Dir" />
    <div class="col-md">
        <input type="search" name="q" value="@Model.Q" class="form-control" placeholder="@L["Search"].Value" />
    </div>
    <div class="col-md-auto">
        <select name="typeId" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllTypes"]</option>
            @foreach (var t in Model.TypeOptions)
            {
                <option value="@t.Id" selected="@(Model.TypeId == t.Id)">@t.Name</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="seedType" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllSeedTypes"]</option>
            @foreach (var st in Enum.GetValues<SeedType>())
            {
                <option value="@st" selected="@(Model.SeedTypeFilter == st)">@L["SeedType_" + st]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="stock" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllStock"]</option>
            @foreach (var s in Enum.GetValues<StockStatus>())
            {
                <option value="@s" selected="@(Model.Stock == s)">@L["StockStatus_" + s]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="cultivation" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllCultivations"]</option>
            @foreach (var c in Enum.GetValues<CultivationMethod>())
            {
                <option value="@c" selected="@(Model.CultivationFilter == c)">@L["CultivationMethod_" + c]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="nutrient" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllNutrientDemands"]</option>
            @foreach (var n in Enum.GetValues<NutrientDemand>())
            {
                <option value="@n" selected="@(Model.NutrientFilter == n)">@L["NutrientDemand_" + n]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="exposure" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllExposures"]</option>
            @foreach (var e in Enum.GetValues<Exposure>())
            {
                <option value="@e" selected="@(Model.ExposureFilter == e)">@L["Exposure_" + e]</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <select name="month" class="form-select" onchange="this.form.submit()">
            <option value="">@L["AllMonths"]</option>
            @for (var month = 1; month <= 12; month++)
            {
                <option value="@month" selected="@(Model.Month == month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
            }
        </select>
    </div>
    <div class="col-md-auto d-flex align-items-center">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="toBuy" name="toBuy" value="true" checked="@Model.OnlyToBuy" onchange="this.form.submit()" />
            <label class="form-check-label" for="toBuy">@L["Filter_OnlyToBuy"]</label>
        </div>
    </div>
</form>

@{
    // Addresses of the column titles (keep the filters, reverse the direction on a second click)
    var sort_name = Model.SortRoute("name");
    var sort_type = Model.SortRoute("type");
    var sort_seedtype = Model.SortRoute("seedtype");
    var sort_stock = Model.SortRoute("stock");
    var sort_cultivation = Model.SortRoute("cultivation");
    var sort_nutrient = Model.SortRoute("nutrient");
    var sort_exposure = Model.SortRoute("exposure");
    var sort_tobuy = Model.SortRoute("tobuy");
}

<div class="table-responsive">
<table class="table table-hover">
    <thead>
        <tr>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_name" class="text-decoration-none text-reset">@L["Col_Name"]@Model.Arrow("name")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_type" class="text-decoration-none text-reset">@L["Col_PlantType"]@Model.Arrow("type")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_seedtype" class="text-decoration-none text-reset">@L["Col_SeedType"]@Model.Arrow("seedtype")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_stock" class="text-decoration-none text-reset">@L["Col_Stock"]@Model.Arrow("stock")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_cultivation" class="text-decoration-none text-reset">@L["Col_Cultivation"]@Model.Arrow("cultivation")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_nutrient" class="text-decoration-none text-reset">@L["Col_NutrientDemand"]@Model.Arrow("nutrient")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_exposure" class="text-decoration-none text-reset">@L["Col_Exposure"]@Model.Arrow("exposure")</a></th>
            <th><a asp-page="/Plants/Index" asp-all-route-data="sort_tobuy" class="text-decoration-none text-reset">@L["Badge_ToBuy"]@Model.Arrow("tobuy")</a></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>
                    @if (r.IsUnnamed)
                    {
                        <span class="text-muted fst-italic">@L["Plant_Unnamed"]</span>
                    }
                    else
                    {
                        <strong>@r.Name</strong>
                    }
                </td>
                <td>@r.TypeName</td>
                <td>@L["SeedType_" + r.SeedType]</td>
                <td>@L["StockStatus_" + r.StockStatus]</td>
                <td>@(r.CultivationMethod is null ? "–" : L["CultivationMethod_" + r.CultivationMethod].Value)</td>
                <td>@(r.NutrientDemand is null ? "–" : L["NutrientDemand_" + r.NutrientDemand].Value)</td>
                <td>@(r.Exposure is null ? "–" : L["Exposure_" + r.Exposure].Value)</td>
                <td>@if (r.ShouldBuy) { <span class="badge text-bg-warning">@L["Badge_ToBuy"]</span> }</td>
                <td class="text-end"><a asp-page="Edit" asp-route-id="@r.Id">@L["Action_Edit"]</a></td>
            </tr>
        }
    </tbody>
</table>
</div>
