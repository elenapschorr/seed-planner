@page "{id:int?}"
@model SeedPlanner.Api.Pages.Plants.EditModel
@{
    ViewData["Title"] = (Model.Id is null ? L["Edit_TitleNew"] : L["Edit_TitleEdit"]).Value;
}

<h1 class="mb-3">@ViewData["Title"]</h1>

<form method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="Input.PlantTypeId" class="form-label">@L["Col_PlantType"]</label>
        <select asp-for="Input.PlantTypeId" asp-items="Model.TypeOptions" class="form-select"></select>
        <span asp-validation-for="Input.PlantTypeId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Name" class="form-label">@L["Col_Name"]</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.SeedType" class="form-label">@L["Col_SeedType"]</label>
        <select asp-for="Input.SeedType" asp-items="Model.SeedTypeOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.StockStatus" class="form-label">@L["Col_Stock"]</label>
        <select asp-for="Input.StockStatus" asp-items="Model.StockOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.CultivationMethod" class="form-label">@L["Col_Cultivation"]</label>
        <select asp-for="Input.CultivationMethod" asp-items="Model.CultivationOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Exposure" class="form-label">@L["Col_Exposure"]</label>
        <select asp-for="Input.Exposure" asp-items="Model.ExposureOptions" class="form-select"></select>
    </div>

    <div class="col-md-6">
        <label class="form-label">@L["Field_GerminationDays"]</label>
        <div class="input-group">
            <input asp-for="Input.GerminationDaysMin" class="form-control" />
            <input asp-for="Input.GerminationDaysMax" class="form-control" />
        </div>
        <span asp-validation-for="Input.GerminationDaysMin" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">@L["Field_MaturityDays"]</label>
        <div class="input-group">
            <input asp-for="Input.MaturityDaysMin" class="form-control" />
            <input asp-for="Input.MaturityDaysMax" class="form-control" />
        </div>
        <span asp-validation-for="Input.MaturityDaysMin" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.RowSpacingCm" class="form-label">@L["Field_RowSpacing"]</label>
        <input asp-for="Input.RowSpacingCm" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Input.PlantSpacingCm" class="form-label">@L["Field_PlantSpacing"]</label>
        <input asp-for="Input.PlantSpacingCm" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label">@L["Field_PotSize"]</label>
        <div class="input-group">
            <input asp-for="Input.PotSizeMinCm" class="form-control" />
            <input asp-for="Input.PotSizeMaxCm" class="form-control" />
        </div>
        <span asp-validation-for="Input.PotSizeMinCm" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">@L["Field_Sowing1"]</label>
        <div class="input-group">
            <select asp-for="Input.Sow1From" asp-items="Model.MonthOptions" class="form-select"></select>
            <select asp-for="Input.Sow1To" asp-items="Model.MonthOptions" class="form-select"></select>
        </div>
        <span asp-validation-for="Input.Sow1From" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">@L["Field_Sowing2"]</label>
        <div class="input-group">
            <select asp-for="Input.Sow2From" asp-items="Model.MonthOptions" class="form-select"></select>
            <select asp-for="Input.Sow2To" asp-items="Model.MonthOptions" class="form-select"></select>
        </div>
        <span asp-validation-for="Input.Sow2From" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">@L["Field_Harvest1"]</label>
        <div class="input-group">
            <select asp-for="Input.Harv1From" asp-items="Model.MonthOptions" class="form-select"></select>
            <select asp-for="Input.Harv1To" asp-items="Model.MonthOptions" class="form-select"></select>
        </div>
        <span asp-validation-for="Input.Harv1From" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">@L["Field_Harvest2"]</label>
        <div class="input-group">
            <select asp-for="Input.Harv2From" asp-items="Model.MonthOptions" class="form-select"></select>
            <select asp-for="Input.Harv2To" asp-items="Model.MonthOptions" class="form-select"></select>
        </div>
        <span asp-validation-for="Input.Harv2From" class="text-danger"></span>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-success">@L["Action_Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="Index">@L["Action_Cancel"]</a>
    </div>
</form>

@if (Model.Id is not null)
{
    var confirmText = L["Confirm_Delete"].Value;
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="mt-4"
          data-confirm="@confirmText" onsubmit="return confirm(this.dataset.confirm);">
        <button type="submit" class="btn btn-outline-danger">@L["Action_Delete"]</button>
    </form>
}
