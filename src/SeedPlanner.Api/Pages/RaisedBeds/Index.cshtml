@page
@model SeedPlanner.Api.Pages.RaisedBeds.IndexModel
@using System.Globalization
@using SeedPlanner.Domain
@{
    ViewData["Title"] = L["RaisedBeds_Title"].Value;
    ViewData["Wide"] = true;

}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="mb-0">@L["RaisedBeds_Title"]</h1>
    <a class="btn btn-success" asp-page="Edit">@L["RaisedBeds_New"]</a>
</div>
<p class="text-muted">@L["RaisedBeds_Summary", Model.TotalArea.ToString("0.0", CultureInfo.CurrentCulture)]</p>

<partial name="_FilterBar" model="Model.Filter" />

<div class="table-responsive">
<table class="table table-hover">
    <thead>
        <tr>
            <th><a href="@Model.Filter.SortUrl("name")" class="text-decoration-none text-reset">@L["Col_Name"]@Model.Filter.Arrow("name")</a></th>
            <th><a href="@Model.Filter.SortUrl("kind")" class="text-decoration-none text-reset">@L["Col_BedKind"]@Model.Filter.Arrow("kind")</a></th>
            <th><a href="@Model.Filter.SortUrl("shape")" class="text-decoration-none text-reset">@L["Col_Shape"]@Model.Filter.Arrow("shape")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("width")" class="text-decoration-none text-reset">@L["Col_Width"]@Model.Filter.Arrow("width")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("length")" class="text-decoration-none text-reset">@L["Col_Length"]@Model.Filter.Arrow("length")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("height")" class="text-decoration-none text-reset">@L["Col_Height"]@Model.Filter.Arrow("height")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("area")" class="text-decoration-none text-reset">@L["Col_Area"]@Model.Filter.Arrow("area")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("volume")" class="text-decoration-none text-reset">@L["Col_SoilVolume"]@Model.Filter.Arrow("volume")</a></th>
            <th><a href="@Model.Filter.SortUrl("plantings")" class="text-decoration-none text-reset">@L["Col_Plantings"]@Model.Filter.Arrow("plantings")</a></th>
            <th><a href="@Model.Filter.SortUrl("note")" class="text-decoration-none text-reset">@L["Col_Note"]@Model.Filter.Arrow("note")</a></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><a asp-page="Edit" asp-route-id="@r.Id" title="@L["Action_Edit"].Value"><strong>@r.Name</strong></a></td>
                <td>@L["BedKind_" + r.Kind]</td>
                <td>@L["BedShape_" + r.Shape]</td>
                <td class="text-end">@r.WidthCm.ToString("0.#", CultureInfo.CurrentCulture)</td>
                <td class="text-end">@r.LengthCm.ToString("0.#", CultureInfo.CurrentCulture)</td>
                <td class="text-end">@(r.HeightCm is null ? "–" : r.HeightCm.Value.ToString("0.#", CultureInfo.CurrentCulture))</td>
                <td class="text-end">@r.AreaSquareMeters.ToString("0.00", CultureInfo.CurrentCulture)</td>
                <td class="text-end">@(r.VolumeLiters is null ? "–" : r.VolumeLiters.Value.ToString("0", CultureInfo.CurrentCulture))</td>
                <td>@r.Plantings</td>
                <td>@(r.Note ?? "")</td>
            </tr>
        }
    </tbody>
</table>
</div>
