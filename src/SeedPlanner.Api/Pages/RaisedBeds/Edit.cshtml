@page "{id:int?}"
@model SeedPlanner.Api.Pages.RaisedBeds.EditModel
@{
    ViewData["Title"] = (Model.Id is null ? L["RaisedBeds_New"] : L["BedEdit_TitleEdit"]).Value;
}

<h1 class="mb-3">@ViewData["Title"]</h1>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Input.Name" class="form-label">@L["Col_Name"]</label>
        <input asp-for="Input.Name" class="form-control" maxlength="100" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Kind" class="form-label">@L["Col_BedKind"]</label>
        <select asp-for="Input.Kind" asp-items="Model.KindOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Shape" class="form-label">@L["Col_Shape"]</label>
        <select asp-for="Input.Shape" asp-items="Model.ShapeOptions" class="form-select"></select>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.WidthCm" class="form-label">@L["Col_Width"]</label>
        <input asp-for="Input.WidthCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.WidthCm" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.LengthCm" class="form-label">@L["Col_Length"]</label>
        <input asp-for="Input.LengthCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.LengthCm" class="text-danger"></span>
    </div>
    <div class="col-md-4" id="height-field">
        <label asp-for="Input.HeightCm" class="form-label">@L["Col_Height"]</label>
        <input asp-for="Input.HeightCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.HeightCm" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Input.HasCover" class="form-check-input" />
            <label asp-for="Input.HasCover" class="form-check-label">@L["Col_HasCover"]</label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Input.Note" class="form-label">@L["Col_Note"]</label>
        <input asp-for="Input.Note" class="form-control" maxlength="200" />
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-success">@L["Action_Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="Index">@L["Action_Cancel"]</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <hr class="my-4" />
    <h2 class="h5">@L["Col_Plantings"]</h2>

    @if (Model.PlantingError is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.PlantingError</div>
    }

    @if (Model.Plantings.Count > 0)
    {
        <ul class="list-unstyled">
            @foreach (var x in Model.Plantings)
            {
                @if (Model.EditingId == x.Id)
                {
                    <li class="mb-2">
                        <form method="post" asp-page-handler="UpdatePlanting" asp-route-id="@Model.Id" class="row g-2">
                            <input type="hidden" name="plantingId" value="@x.Id" />
                            <div class="col-md-5">
                                <select name="choice" asp-items="Model.EditOptions" class="form-select form-select-sm"></select>
                            </div>
                            <div class="col-md-2">
                                <input type="number" name="plantCount" min="1" value="@x.PlantCount" class="form-control form-control-sm" placeholder="@L["Field_PlantCount"].Value" />
                            </div>
                            <div class="col-md-3">
                                <input type="text" name="note" maxlength="200" value="@x.Note" class="form-control form-control-sm" placeholder="@L["Col_Note"].Value" />
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn btn-success btn-sm">@L["Action_Save"]</button>
                                <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@Model.Id">@L["Action_Cancel"]</a>
                            </div>
                        </form>
                    </li>
                }
                else
                {
                    <li class="d-flex align-items-center gap-3 mb-1">
                        <span>@x.Name@(x.PlantCount is null ? "" : $" ×{x.PlantCount}")@(string.IsNullOrEmpty(x.Note) ? "" : $" ({x.Note})")</span>
                        <a class="btn btn-link btn-sm p-0" asp-page="Edit" asp-route-id="@Model.Id" asp-route-editPlanting="@x.Id">@L["Action_Edit"]</a>
                        <form method="post" asp-page-handler="RemovePlanting" asp-route-id="@Model.Id" class="d-inline">
                            <input type="hidden" name="plantingId" value="@x.Id" />
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">@L["Neighbours_Remove"]</button>
                        </form>
                    </li>
                }
            }
        </ul>
    }

    <form method="post" asp-page-handler="AddPlanting" asp-route-id="@Model.Id" class="row g-2 mb-3">
        <div class="col-md-5">
            <select name="choice" asp-items="Model.PlantOptions" class="form-select"></select>
        </div>
        <div class="col-md-2">
            <input type="number" name="plantCount" min="1" class="form-control" placeholder="@L["Field_PlantCount"].Value" />
        </div>
        <div class="col-md-3">
            <input type="text" name="note" maxlength="200" class="form-control" placeholder="@L["Col_Note"].Value" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-success">@L["Action_Add"]</button>
        </div>
    </form>

    <div class="mt-4">
        <a class="btn btn-primary" asp-page="Index">@L["Pots_Done"]</a>
    </div>

    var confirmText = L["BedConfirm_Delete"].Value;
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="mt-4"
          data-confirm="@confirmText" onsubmit="return confirm(this.dataset.confirm);">
        <button type="submit" class="btn btn-outline-danger">@L["Action_Delete"]</button>
    </form>
}

<script>
    // A ground bed has no walls: hide the height
    (function () {
        var kind = document.getElementById("Input_Kind");
        var height = document.getElementById("height-field");
        function update() { height.hidden = kind.value === "Ground"; }
        kind.addEventListener("change", update);
        update();
    })();
</script>
