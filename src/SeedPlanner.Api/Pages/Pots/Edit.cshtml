@page "{id:int?}"
@model SeedPlanner.Api.Pages.Pots.EditModel
@{
    ViewData["Title"] = (Model.Id is null ? L["PotEdit_TitleNew"] : L["PotEdit_TitleEdit"]).Value;
}

<h1 class="mb-3">@ViewData["Title"]</h1>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Input.Kind" class="form-label">@L["Col_Kind"]</label>
        <select asp-for="Input.Kind" asp-items="Model.KindOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Shape" class="form-label">@L["Col_Shape"]</label>
        <select asp-for="Input.Shape" asp-items="Model.ShapeOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Quantity" class="form-label">@L["Col_Quantity"]</label>
        <input asp-for="Input.Quantity" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.SetSize" class="form-label">@L["Field_SetSize"]</label>
        <input asp-for="Input.SetSize" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Input.SetSize" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.TopCm" class="form-label">@L["Field_TopCm"]</label>
        <input asp-for="Input.TopCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.TopCm" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.BottomCm" class="form-label">@L["Field_BottomCm"]</label>
        <input asp-for="Input.BottomCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.BottomCm" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.HeightCm" class="form-label">@L["Col_Height"]</label>
        <input asp-for="Input.HeightCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.HeightCm" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.Color" class="form-label">@L["Col_Color"]</label>
        <input asp-for="Input.Color" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Code" class="form-label">@L["Col_Code"]</label>
        <input asp-for="Input.Code" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="Input.SaucerId" class="form-label">@L["Col_Saucer"]</label>
        <select asp-for="Input.SaucerId" asp-items="Model.SaucerOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Note" class="form-label">@L["Col_Note"]</label>
        <input asp-for="Input.Note" class="form-control" maxlength="200" />
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-success">@L["Action_Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="Index">@L["Action_Cancel"]</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <hr class="my-4" />
    <h2 class="h5">@L["PotUses_Title"]</h2>
    <p class="text-muted">@L["PotUses_Summary", Model.Input.Quantity, Model.Occupied, Model.Free]</p>

    @foreach (var u in Model.Uses)
    {
        <div class="border rounded p-2 mb-2">
            <div class="d-flex align-items-center gap-3 mb-1">
                <strong>@L["PotUse_Pots", u.Quantity]</strong>
                <form method="post" asp-page-handler="RemoveUse" asp-route-id="@Model.Id" class="d-inline ms-auto">
                    <input type="hidden" name="useId" value="@u.Id" />
                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger">@L["PotUse_RemoveEntry"]</button>
                </form>
            </div>
            <ul class="list-unstyled mb-2">
                @foreach (var x in u.Plants)
                {
                    <li class="d-flex align-items-center gap-3">
                        <span>@x.Name</span>
                        <form method="post" asp-page-handler="RemovePlant" asp-route-id="@Model.Id" class="d-inline">
                            <input type="hidden" name="useId" value="@u.Id" />
                            <input type="hidden" name="plantRowId" value="@x.Id" />
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">@L["Neighbours_Remove"]</button>
                        </form>
                    </li>
                }
            </ul>
            <form method="post" asp-page-handler="AddPlant" asp-route-id="@Model.Id" class="row g-2">
                <input type="hidden" name="useId" value="@u.Id" />
                <div class="col-md-6">
                    <select name="choice" asp-items="Model.UseOptions" class="form-select form-select-sm"></select>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">@L["PotUse_AddPlant"]</button>
                </div>
            </form>
        </div>
    }

    <h3 class="h6 mt-3">@L["PotUse_NewEntry"]</h3>
    <form method="post" asp-page-handler="AddUse" asp-route-id="@Model.Id" class="row g-2 mb-3">
        <div class="col-md-5">
            <select name="choice" asp-items="Model.UseOptions" class="form-select"></select>
        </div>
        <div class="col-md-2">
            <input type="number" name="quantity" value="1" min="1" class="form-control" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-success">@L["Action_Add"]</button>
        </div>
    </form>

    var confirmText = L["PotConfirm_Delete"].Value;
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="mt-4"
          data-confirm="@confirmText" onsubmit="return confirm(this.dataset.confirm);">
        <button type="submit" class="btn btn-outline-danger">@L["Action_Delete"]</button>
    </form>
}
