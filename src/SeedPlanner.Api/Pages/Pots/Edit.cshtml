@page "{id:int?}"
@model SeedPlanner.Api.Pages.Pots.EditModel
@{
    ViewData["Title"] = (Model.Id is null ? L["PotEdit_TitleNew"] : L["PotEdit_TitleEdit"]).Value;
}

<h1 class="mb-3">@ViewData["Title"]</h1>

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Input.Name" class="form-label">@L["Field_GroupName"]</label>
        <input asp-for="Input.Name" class="form-control" maxlength="100" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Kind" class="form-label">@L["Col_Kind"]</label>
        <select asp-for="Input.Kind" asp-items="Model.KindOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Shape" class="form-label">@L["Col_Shape"]</label>
        <select asp-for="Input.Shape" asp-items="Model.ShapeOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Quantity" class="form-label">@L["Pots_NumberOfPots"]</label>
        <input asp-for="Input.Quantity" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.SetSize" class="form-label">@L["Field_SetSize"]</label>
        <input asp-for="Input.SetSize" class="form-control" inputmode="numeric" />
        <span asp-validation-for="Input.SetSize" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.TopCm" class="form-label">@L["Field_TopCm"]</label>
        <input asp-for="Input.TopCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.TopCm" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.BottomCm" class="form-label">@L["Field_BottomCm"]</label>
        <input asp-for="Input.BottomCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.BottomCm" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.HeightCm" class="form-label">@L["Col_Height"]</label>
        <input asp-for="Input.HeightCm" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Input.HeightCm" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Input.Color" class="form-label">@L["Col_Color"]</label>
        <input asp-for="Input.Color" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Code" class="form-label">@L["Col_Code"]</label>
        <input asp-for="Input.Code" class="form-control" maxlength="50" />
    </div>
    <div class="col-md-3">
        <label asp-for="Input.SaucerId" class="form-label">@L["Col_Saucer"]</label>
        <select asp-for="Input.SaucerId" asp-items="Model.SaucerOptions" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.Note" class="form-label">@L["Col_Note"]</label>
        <input asp-for="Input.Note" class="form-control" maxlength="200" />
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-success">@L["Action_Save"]</button>
        <a class="btn btn-outline-secondary" asp-page="Index">@L["Action_Cancel"]</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <hr class="my-4" />
    <h2 class="h5">@L["PotUses_Title"]</h2>
    <p class="text-muted">@L["PotUses_Summary", Model.Quantity, Model.Occupied, Model.Free]</p>

    @if (Model.PlantingError is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.PlantingError</div>
    }

    @if (Model.UsedPots.Count > 0)
    {
        <ul class="list-unstyled">
            @foreach (var pot in Model.UsedPots)
            {
                <li class="border rounded p-2 mb-2">
                    <strong>@L["Pot_Number", pot.Number]</strong>
                    <ul class="list-unstyled mb-2">
                        @foreach (var x in pot.Plantings)
                        {
                            @if (Model.EditingId == x.Id)
                            {
                                <li class="mb-2">
                                    <form method="post" asp-page-handler="UpdatePlanting" asp-route-id="@Model.Id" class="row g-2">
                                        <input type="hidden" name="plantingId" value="@x.Id" />
                                        <div class="col-md-5">
                                            <select name="choice" asp-items="Model.EditOptions" class="form-select form-select-sm"></select>
                                        </div>
                                        <div class="col-md-2">
                                            <input type="number" name="plantCount" min="1" value="@x.PlantCount" class="form-control form-control-sm" placeholder="@L["Field_PlantCount"].Value" />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" name="note" maxlength="200" value="@x.Note" class="form-control form-control-sm" placeholder="@L["Col_Note"].Value" />
                                        </div>
                                        <div class="col-md-auto">
                                            <button type="submit" class="btn btn-success btn-sm">@L["Action_Save"]</button>
                                            <a class="btn btn-outline-secondary btn-sm" asp-page="Edit" asp-route-id="@Model.Id">@L["Action_Cancel"]</a>
                                        </div>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="d-flex align-items-center gap-3">
                                    <span>@x.Name@(x.PlantCount is null ? "" : $" ×{x.PlantCount}")@(string.IsNullOrEmpty(x.Note) ? "" : $" ({x.Note})")</span>
                                    <a class="btn btn-link btn-sm p-0" asp-page="Edit" asp-route-id="@Model.Id" asp-route-editPlanting="@x.Id">@L["Action_Edit"]</a>
                                    <form method="post" asp-page-handler="RemovePlanting" asp-route-id="@Model.Id" class="d-inline">
                                        <input type="hidden" name="plantingId" value="@x.Id" />
                                        <button type="submit" class="btn btn-link btn-sm p-0 text-danger">@L["Neighbours_Remove"]</button>
                                    </form>
                                </li>
                            }
                        }
                    </ul>
                    <form method="post" asp-page-handler="AddToPot" asp-route-id="@Model.Id" class="row g-2">
                        <input type="hidden" name="potId" value="@pot.Id" />
                        <div class="col-md-6">
                            <select name="choice" asp-items="Model.PlantOptions" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-md-2">
                            <input type="number" name="plantCount" min="1" class="form-control form-control-sm" placeholder="@L["Field_PlantCount"].Value" />
                        </div>
                        <div class="col-md-auto">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@L["PotUse_AddPlant"]</button>
                        </div>
                    </form>
                </li>
            }
        </ul>
    }

    @if (Model.Free > 0)
    {
        <h3 class="h6 mt-3">@L["Pots_FillFree"]</h3>
        <form method="post" asp-page-handler="AddToFreePots" asp-route-id="@Model.Id" class="row g-2 mb-3">
            <div class="col-md-5">
                <select name="choice" asp-items="Model.PlantOptions" class="form-select"></select>
            </div>
            <div class="col-md-2">
                <input type="number" name="quantity" value="1" min="1" max="@Model.Free" class="form-control" title="@L["Pots_NumberOfPots"].Value" />
            </div>
            <div class="col-md-2">
                <input type="number" name="plantCount" min="1" class="form-control" placeholder="@L["Field_PlantCount"].Value" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-success">@L["Action_Add"]</button>
            </div>
        </form>
    }

    <div class="mt-4">
        <a class="btn btn-primary" asp-page="Index">@L["Pots_Done"]</a>
    </div>

    var confirmText = L["PotConfirm_Delete"].Value;
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="mt-4"
          data-confirm="@confirmText" onsubmit="return confirm(this.dataset.confirm);">
        <button type="submit" class="btn btn-outline-danger">@L["Action_Delete"]</button>
    </form>
}
