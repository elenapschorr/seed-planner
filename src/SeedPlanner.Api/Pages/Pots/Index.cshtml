@page
@model SeedPlanner.Api.Pages.Pots.IndexModel
@using SeedPlanner.Domain
@{
    ViewData["Title"] = L["Pots_Title"].Value;
    ViewData["Wide"] = true;

}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="mb-0">@L["Pots_Title"]</h1>
    <a class="btn btn-success" asp-page="Edit">@L["Pots_New"]</a>
</div>
<p class="text-muted">@L["Pots_Summary", Model.TotalPots, Model.TotalFree]</p>

<partial name="_FilterBar" model="Model.Filter" />

<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th><a href="@Model.Filter.SortUrl("name")" class="text-decoration-none text-reset">@L["Col_Group"]@Model.Filter.Arrow("name")</a></th>
            <th><a href="@Model.Filter.SortUrl("kind")" class="text-decoration-none text-reset">@L["Col_Kind"]@Model.Filter.Arrow("kind")</a></th>
            <th><a href="@Model.Filter.SortUrl("shape")" class="text-decoration-none text-reset">@L["Col_Shape"]@Model.Filter.Arrow("shape")</a></th>
            <th><a href="@Model.Filter.SortUrl("size")" class="text-decoration-none text-reset">@L["Col_Size"]@Model.Filter.Arrow("size")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("volume")" class="text-decoration-none text-reset">@L["Col_Volume"]@Model.Filter.Arrow("volume")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("quantity")" class="text-decoration-none text-reset">@L["Col_Quantity"]@Model.Filter.Arrow("quantity")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("inuse")" class="text-decoration-none text-reset">@L["Col_InUse"]@Model.Filter.Arrow("inuse")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("free")" class="text-decoration-none text-reset">@L["Col_Free"]@Model.Filter.Arrow("free")</a></th>
            <th><a href="@Model.Filter.SortUrl("color")" class="text-decoration-none text-reset">@L["Col_Color"]@Model.Filter.Arrow("color")</a></th>
            <th><a href="@Model.Filter.SortUrl("code")" class="text-decoration-none text-reset">@L["Col_Code"]@Model.Filter.Arrow("code")</a></th>
            <th><a href="@Model.Filter.SortUrl("saucer")" class="text-decoration-none text-reset">@L["Col_Saucer"]@Model.Filter.Arrow("saucer")</a></th>
            <th><a href="@Model.Filter.SortUrl("uses")" class="text-decoration-none text-reset">@L["Col_UsedFor"]@Model.Filter.Arrow("uses")</a></th>
            <th><a href="@Model.Filter.SortUrl("note")" class="text-decoration-none text-reset">@L["Col_Note"]@Model.Filter.Arrow("note")</a></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><a asp-page="Edit" asp-route-id="@r.Id" title="@L["Action_Edit"].Value"><strong>@r.Name</strong></a></td>
                <td>@L["PotKind_" + r.Kind]</td>
                <td>@L["PotShape_" + r.Shape]</td>
                <td>@Model.Size(r)</td>
                <td class="text-end">@(r.Volume is null ? "–" : r.Volume.Value.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture))</td>
                <td class="text-end">
                    @r.Quantity
                    @if (r.SetSize > 1)
                    {
                        <span class="text-muted small">(@L["Pots_Towers", r.SetCount, r.SetSize])</span>
                    }
                </td>
                <td class="text-end">@r.Occupied</td>
                <td class="text-end">@r.Free</td>
                <td>@(r.Color ?? "–")</td>
                <td>@(r.Code ?? "–")</td>
                <td>@(r.Saucer ?? "–")</td>
                <td class="col-uses">@(r.Uses.Length == 0 ? "–" : r.Uses)</td>
                <td class="col-note">@(r.Note ?? "")</td>
            </tr>
        }
    </tbody>
</table>
</div>
