@page
@model SeedPlanner.Api.Pages.Saucers.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = L["Saucers_Title"].Value;
    ViewData["Wide"] = true;

}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="mb-0">@L["Saucers_Title"]</h1>
    <a class="btn btn-success" asp-page="Edit">@L["Saucers_New"]</a>
</div>
<p class="text-muted">@L["Saucers_Summary", Model.TotalSaucers]</p>

<partial name="_FilterBar" model="Model.Filter" />

<div class="table-responsive">
<table class="table table-hover">
    <thead>
        <tr>
            <th><a href="@Model.Filter.SortUrl("diameter")" class="text-decoration-none text-reset">@L["Col_Diameter"]@Model.Filter.Arrow("diameter")</a></th>
            <th><a href="@Model.Filter.SortUrl("color")" class="text-decoration-none text-reset">@L["Col_Color"]@Model.Filter.Arrow("color")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("quantity")" class="text-decoration-none text-reset">@L["Col_Quantity"]@Model.Filter.Arrow("quantity")</a></th>
            <th class="text-end"><a href="@Model.Filter.SortUrl("pots")" class="text-decoration-none text-reset">@L["Col_AssignedPots"]@Model.Filter.Arrow("pots")</a></th>
            <th><a href="@Model.Filter.SortUrl("note")" class="text-decoration-none text-reset">@L["Col_Note"]@Model.Filter.Arrow("note")</a></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td><a asp-page="Edit" asp-route-id="@r.Id" title="@L["Action_Edit"].Value"><strong>@r.DiameterCm.ToString("0.#", CultureInfo.CurrentCulture)</strong></a></td>
                <td>@(r.Color ?? "–")</td>
                <td class="text-end">@r.Quantity</td>
                <td class="text-end">@r.PotCount</td>
                <td>@(r.Note ?? "")</td>
            </tr>
        }
    </tbody>
</table>
</div>
